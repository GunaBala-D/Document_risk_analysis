# Copy to .env and fill in. Never commit .env.

# --- Database ---
# PostgreSQL (docker-compose service "postgres"). For a quick local run without Postgres:
#   DATABASE_URL=sqlite:///./data/dre_local.db
DATABASE_URL=postgresql+psycopg://dre:change-me@localhost:5432/document_risk
POSTGRES_USER=dre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=document_risk

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT=document-risk-engine
CLASSIFIER_MODEL_NAME=document-risk-classifier
ANOMALY_MODEL_NAME=document-anomaly-detector

# --- Ollama (optional; the system works without it) ---
LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- OCR ---
# Leave empty if tesseract is on PATH
TESSERACT_CMD=

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# --- Auth: demo API keys created by scripts/seed_users.py (generate your own, >= 24 chars) ---
SEED_ADMIN_KEY=
SEED_ANALYST_KEY=
SEED_RISK_MANAGER_KEY=

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
